:root {
    --color-ink: #060a12;
    --color-stone: #16222f;
    --color-stone-light: #22384a;
    --color-teal: #4fd8c4;
    --color-teal-dim: #2f8f80;
    --color-red: #e0555f;
    --color-text: #eaf2f2;
}

.dim-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(3, 6, 14, 0.82);
    align-items: center;
    justify-content: center;
}

.hidden {
    display: none;
}

.panel {
    background-color: var(--color-stone);
    border-width: 3px;
    border-color: var(--color-teal-dim);
    border-radius: 6px;
    padding: 28px 36px;
    align-items: center;
    min-width: 360px;
}

.heading {
    font-size: 40px;
    -unity-font-style: bold;
    color: var(--color-teal);
    letter-spacing: 2px;
    margin-bottom: 22px;
    -unity-text-align: middle-center;
}

.button-row {
    flex-direction: row;
}

.pixel-button {
    min-width: 120px;
    height: 44px;
    margin: 0 8px;
    background-color: var(--color-stone-light);
    border-width: 2px;
    border-color: var(--color-teal-dim);
    border-radius: 3px;
    color: var(--color-text);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.pixel-button:hover {
    background-color: var(--color-teal-dim);
}

.pixel-button--ghost {
    background-color: rgba(0, 0, 0, 0);
    border-color: var(--color-red);
    color: var(--color-red);
}

.pixel-button--ghost:hover {
    background-color: rgba(224, 85, 95, 0.18);
}
